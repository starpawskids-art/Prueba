# Web Push (real browser push notifications — see README "Push notifications").
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any mailto: address or https: URL the push services can contact if something's wrong.
VAPID_SUBJECT=mailto:you@example.com

# Same value as VAPID_PUBLIC_KEY, exposed to the browser bundle. Next.js
# inlines NEXT_PUBLIC_* vars at build time, so this must be set even though
# it duplicates VAPID_PUBLIC_KEY.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# UTC hour (0-23) the daily digest notification fires at. No per-user
# timezone yet — see README. Defaults to 9 (09:00 UTC) if unset.
DIGEST_HOUR_UTC=9
